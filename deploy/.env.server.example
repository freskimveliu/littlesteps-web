# Little Steps — production environment for the shared vault server.
#
# Copy to /opt/littlesteps/laravel/.env and fill in every value marked CHANGEME.
# This file is the single source of truth for the app, queue and scheduler
# containers (all three load it via `env_file`).
#
# Note there is no .env inside the image — the builder stage deletes it — so
# every value the app needs must be here. php-fpm is built with `clear_env = no`
# specifically so these reach PHP.

APP_NAME="Little Steps"
APP_ENV=production
# CHANGEME — generate a fresh one, do NOT reuse the dev key:
#   docker run --rm ghcr.io/freskimveliu/littlesteps-web:main php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_URL=https://littlesteps.freskimveliu.dev
ASSET_URL=https://littlesteps.freskimveliu.dev

# Caddy terminates TLS and forwards plain HTTP. Without this Laravel builds
# http:// URLs for every route and asset. bootstrap/app.php already calls
# trustProxies(at: '*'); this keeps the two consistent.
TRUSTED_PROXIES=*

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# `debug` on a 2 GB box fills the disk quickly and leaks request detail.
LOG_LEVEL=warning

# --- Database -----------------------------------------------------------
# vault's MariaDB 10.11, reached by container name across vault_network.
# Little Steps gets its own database and its own user — it must not be able to
# read vault's tables. Create both with the SQL in DEPLOYMENT.md.
#
# MariaDB rather than the MySQL 8.4 of the dev stack. That is safe here: the
# only json() columns are Spatie's media table, and the app makes no
# whereJsonContains / whereJsonLength / fullText calls anywhere.
DB_CONNECTION=mysql
DB_HOST=vault_database
DB_PORT=3306
DB_DATABASE=littlesteps
DB_USERNAME=littlesteps
DB_PASSWORD=CHANGEME

# --- Redis --------------------------------------------------------------
# Shared with vault, so the DB indexes and the prefix must not collide.
# vault uses the Laravel defaults (0 for the default connection, 1 for cache),
# so Little Steps takes 2 and 3. REDIS_PREFIX is belt-and-braces: even on a
# shared index, keys stay in their own namespace.
REDIS_CLIENT=phpredis
REDIS_HOST=vault_redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGEME
REDIS_DB=2
REDIS_CACHE_DB=3
REDIS_PREFIX=littlesteps_database_
CACHE_PREFIX=littlesteps_cache

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies must only travel over HTTPS in production.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@littlesteps.freskimveliu.dev"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Note: DOCKER_IMAGE_TAG deliberately does NOT live here. This file is loaded
# via `env_file:`, which injects variables into containers but has no effect on
# the ${...} interpolation in the compose file itself — compose reads that from
# /opt/littlesteps/.env or the shell. deploy.sh exports it before running
# compose, and the compose file defaults to `main` if it is unset.
