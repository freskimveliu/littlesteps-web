# =============================================================================
# Little Steps — deployment configuration
# =============================================================================
# Copy to .env and fill in every value:
#   cp .env.example .env
#
# This file is read by apply.sh and passed to the playbook. It is gitignored.
# =============================================================================

# Server (the existing vault box) and the public hostname for this app.
SERVER_IP=3.121.93.121
LITTLESTEPS_DOMAIN=littlesteps.freskimveliu.dev

# Path to the SSH key for `ubuntu@SERVER_IP`. Defaults to ./ssh_key.
# The vault repo already has this key — symlink it once:
#   ln -s ../../../vault/ansible/ssh_key deploy/ansible/ssh_key
SSH_KEY=

# Laravel application key. Generate a FRESH one — never reuse the dev key:
#   ./bin/docker-exec artisan key:generate --show
APP_KEY=

# -----------------------------------------------------------------------------
# Database — a `littlesteps` database and user inside the vault MariaDB
# -----------------------------------------------------------------------------
# Root password of the vault MariaDB. It is the DB_PASSWORD value in the vault
# repo's ansible/.env (that stack sets MYSQL_ROOT_PASSWORD from it). Used once,
# to create our database and user; it is never written to the server.
VAULT_DB_ROOT_PASSWORD=

# Password for the new `littlesteps` MariaDB user.
# Generate with: openssl rand -base64 24
LITTLESTEPS_DB_PASSWORD=

# -----------------------------------------------------------------------------
# Redis — the vault Redis, on separate database indexes (2 and 3)
# -----------------------------------------------------------------------------
# The REDIS_PASSWORD value from the vault repo's ansible/.env.
VAULT_REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Container registry + deploy webhook
# -----------------------------------------------------------------------------
# GitHub token with read:packages, so the server can pull from GHCR.
# https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_USERNAME=freskimveliu

# Shared secret for the deploy webhook. Must match the DEPLOY_WEBHOOK_SECRET
# repository secret in GitHub Actions.
# Generate with: openssl rand -hex 32
DEPLOY_WEBHOOK_SECRET=

# Host port for this app's webhook listener. 9000 is taken by vault.
WEBHOOK_PORT=9001

# Which image tag the server runs. Leave empty for `main` (the newest build of
# the main branch). Set a commit SHA to pin or roll back.
DOCKER_IMAGE_TAG=

# Add a 2 GB swapfile to the server. The box is a t3.small (2 GB RAM) and this
# stack adds three containers to it — leave this on unless it already has swap.
CREATE_SWAPFILE=true
