# =============================================================================
# Little Steps — deployment configuration
# =============================================================================
# Copy to .env and fill in every value:
#   cp .env.example .env
#
# Read by setup.sh and apply.sh, and passed to the playbooks. Gitignored.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
# Empty until setup.sh has created the instance — it prints the IP to put here.
# Once set, apply.sh targets that server and never provisions another.
SERVER_IP=

LITTLESTEPS_DOMAIN=littlesteps.freskimveliu.dev

# AWS credentials for creating the instance. Only setup.sh needs them.
# https://console.aws.amazon.com/iam → Users → Security credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1

# t3.small is 2 vCPU / 2 GB and fits this stack with the swapfile the playbook
# adds. t3.medium (4 GB) if you would rather not rely on swap.
INSTANCE_TYPE=t3.small
VOLUME_SIZE=20

# Path to the server's SSH key. Empty means ./ssh_key, which setup.sh generates.
SSH_KEY=

# Address Let's Encrypt sends certificate expiry warnings to.
ACME_EMAIL=freskim.veliu@gmail.com

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# A FRESH key — never the dev one:
#   ./bin/docker-exec artisan key:generate --show
APP_KEY=

# Its own MySQL 8.4. Generate each with: openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Its own Redis. openssl rand -base64 24
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# Container registry + deploy webhook
# -----------------------------------------------------------------------------
# GitHub token with read:packages, so the server can pull the image from GHCR.
# https://github.com/settings/tokens
GITHUB_TOKEN=
GITHUB_USERNAME=freskimveliu

# Shared secret for the deploy webhook. The SAME value must be set as the
# DEPLOY_WEBHOOK_SECRET repository secret in GitHub Actions.
# Generate with: openssl rand -hex 32
DEPLOY_WEBHOOK_SECRET=
WEBHOOK_PORT=9000

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
# Which image tag the server runs. Empty means `main` — the newest build of the
# main branch. Set a commit SHA to pin or roll back.
DOCKER_IMAGE_TAG=

# Add a 2 GB swapfile. Leave on for t3.small.
CREATE_SWAPFILE=true
